---

import MainGridLayout from '../layouts/MainGridLayout.astro'

import { Content } from '../content/spec/about.md'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import Markdown from '@components/misc/Markdown.astro'
import Comment from '@components/Comment.astro'
import ProjectShowcase from '../components/ProjectShowcase.astro'

---
<MainGridLayout title={i18n(I18nKey.about)} description="关于 pride7：分享有意思的软件、自己做的游戏和日常发现。">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-5 md:px-6 py-4 md:py-5 relative w-full">
            <Markdown class="prose-h1:!text-2xl prose-h1:!leading-snug prose-h1:!mt-0 prose-h1:!mb-3 prose-p:!my-2 prose-p:!leading-relaxed">
                <Content />
            </Markdown>
        </div>
    </div>

    <div class="mt-3"><ProjectShowcase /></div>

    <Comment></Comment>
</MainGridLayout>
